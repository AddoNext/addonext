{
    "name": "addonext/addonext",
    "type": "wordpress-plugin",
    "description": "Wordpress elementor addons plugin",
    "keywords": [
        "elementor",
        "addons",
        "builder",
        "page"
    ],
    "homepage": "https://addonext.com/",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "wordpress/core",
                "version": "7.1.4",
                "type": "wordpress-core",
                "dist": {
                    "type": "zip",
                    "url": "https://downloads.wordpress.org/release/wordpress-7.1.4.zip"
                },
                "require": {
                    "php": ">=7.4",
                    "johnpbloch/wordpress-core-installer": "^2.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=7.4",
        "php-di/php-di": "^7.0",
        "freemius/wordpress-sdk": "^2.13",
        "matthiasmullie/minify": "^1.3"
    },
    "require-dev": {
        "wordpress/core": "7.1.4",
        "johnpbloch/wordpress-core-installer": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/phpstan": "2.3.1"
    },
    "autoload": {
        "psr-4": {
            "Addonext\\": "./inc",
            "Addonext\\Widgets\\": [
                "inc/Widgets",
                "pro/inc/Widgets"
            ],
            "Addonext\\Extensions\\": [
                "inc/Extensions",
                "pro/inc/Extensions"
            ],
            "Addonext\\Pro\\": "./pro/inc/Pro",
            "Addonext\\Pro\\Migrations\\": "./pro/inc/Migrations"
        },
        "files": [
            "container.php",
            "functions.php"
        ]
    },
    "extra": {
        "wordpress-install-dir": "wordpress"
    },
    "config": {
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true
        }
    }
}
