{
    "name": "addonext/elementrify",
    "type": "wordpress-plugin",
    "description": "Wordpress elementor addons plugin",
    "keywords": [
        "elementor",
        "addons",
        "builder",
        "page"
    ],
    "homepage": "https://elementrify.com/",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "php-di/php-di": "^7.0",
        "freemius/wordpress-sdk": "^2.13",
        "matthiasmullie/minify": "^1.3"
    },
    "require-dev": {
        "johnpbloch/wordpress": "*",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Elementrify\\": "./inc",
            "Elementrify\\Admin\\": "./inc/Admin"
        },
        "files": [
            "container.php",
            "functions.php"
        ]
    },
    "extra": {
        "wordpress-install-dir": "wordpress"
    },
    "config": {
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true
        }
    }
}
